rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonction helper pour vérifier si l'utilisateur est admin
    // Attention : nécessite que le champ 'isAdmin' soit correctement sécurisé ou défini côté serveur/console
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Vérifie si l'utilisateur accède à ses propres données
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Collection des utilisateurs
    match /users/{userId} {
      // Lecture : Soi-même ou Admin
      allow read: if isOwner(userId) || isAdmin();
      
      // Création : Tout utilisateur authentifié peut créer son propre document
      allow create: if isOwner(userId);
      
      // Mise à jour : Soi-même (sauf champ isAdmin) ou Admin
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']))) || isAdmin();
      
      // Suppression : Admin seulement
      allow delete: if isAdmin();

      // Sous-collections (ex: data/progress)
      match /data/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
